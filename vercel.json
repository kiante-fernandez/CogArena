{
  "version": 2,
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/jsPsych-8.2.3/(.*)", "dest": "/jsPsych-8.2.3/$1" },
    { "src": "/tasks/([^/]+)/(index\\.html|experiment\\.js)$", "dest": "/tasks/$1/$2" },
    { "src": "/tasks/([^/]+)/?$", "dest": "/tasks/$1/index.html" }
  ]
}
