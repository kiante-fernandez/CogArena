            "defecting": {"return_rate_min": 0.05, "return_rate_max": 0.15, "n_rounds": 5}
        },
        "response_type": "slider",
        "response_field": "amount_sent",
        "slider_range": [0, 10],
        "response_deadline_ms": 15000,
        "required_fields": ["trial_index", "round", "amount_sent", "amount_returned", "net_payoff"]
    }
