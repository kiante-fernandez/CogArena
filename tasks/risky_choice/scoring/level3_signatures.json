{
    "task_id": "risky_choice",
    "signatures": [
        {
            "name": "risk_aversion_gains",
            "description": "In gain domain, tendency to choose safe option above chance",
            "test": "proportion_test",
            "filter": {"domain": "gain"},
            "field": "chose_safe",
            "chance_level": 0.5,
            "expected_direction": "above_chance",
            "threshold_p": 0.05,
            "weight": 1.0
        },
        {
            "name": "loss_aversion_framing",
            "description": "More risk-seeking in loss domain than gain domain",
            "test": "paired_proportion_test",
            "group_a": {"filter": {"domain": "loss"}, "field": "chose_risky"},
            "group_b": {"filter": {"domain": "gain"}, "field": "chose_risky"},
            "threshold_p": 0.05,
            "expected_direction": "a > b",
            "weight": 1.0
        },
        {
            "name": "ev_sensitivity",
            "description": "Choice correlates with expected value difference",
            "test": "correlation_test",
            "field_x": "ev_difference",
            "field_y": "chose_risky_num",
            "expected_direction": "positive",
            "threshold_p": 0.05,
            "weight": 0.75
        }
    ]
}
