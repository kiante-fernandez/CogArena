{
    "task_id": "n_back",
    "signatures": [
        {
            "name": "above_chance_discrimination",
            "description": "Hit rate exceeds false alarm rate (d' > 0 proxy)",
            "test": "paired_proportion_test",
            "group_a": {"filter": {"n_back_match": true}, "field": "correct"},
            "group_b": {"filter": {"n_back_match": false}, "field": "false_alarm"},
            "threshold_p": 0.05,
            "expected_direction": "a > b",
            "weight": 1.0
        },
        {
            "name": "lure_susceptibility",
            "description": "Higher false alarm rate on lure trials vs non-lure non-targets",
            "test": "paired_proportion_test",
            "group_a": {"filter": {"is_lure": true, "n_back_match": false}, "field": "false_alarm"},
            "group_b": {"filter": {"is_lure": false, "n_back_match": false}, "field": "false_alarm"},
            "threshold_p": 0.05,
            "expected_direction": "a > b",
            "weight": 0.75
        },
        {
            "name": "post_error_slowing",
            "description": "RT increases after an error trial",
            "test": "sequential_regression",
            "predictor": {"field": "correct", "lag": 1, "invert": true},
            "outcome": {"field": "rt"},
            "expected_direction": "positive",
            "threshold_p": 0.05,
            "weight": 0.5
        }
    ]
